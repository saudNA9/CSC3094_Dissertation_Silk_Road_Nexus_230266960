{
  // tsconfig.json
  // TypeScript compiler configuration for the Silk Road Nexus frontend.
  // Key settings:
  // - strict: true   — enables all strict type checks for safer code
  // - paths @/*      — resolves @/components, @/lib, etc. from the project root
  // - jsx react-jsx  — uses the automatic JSX transform (no React import needed)
  // - incremental     — caches the previous compilation to speed up rebuilds
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
